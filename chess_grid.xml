<mujoco model="chess_grid_robot">
  <!-- Board spans -4..4 in x and y (8 squares, 1 unit each) -->
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>

  <visual>
    <headlight ambient="0.35 0.35 0.35"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>

    <!-- Checkerboard texture: 8x8 repeats line up exactly with the 8x8 board -->
    <texture name="chess_tex" type="2d" builtin="checker"
             rgb1="0.92 0.90 0.84" rgb2="0.18 0.14 0.10"
             width="300" height="300"/>
    <material name="chess_mat" texture="chess_tex" texrepeat="1 1" texuniform="true" reflectance="0.1"/>

    <material name="robot_mat" rgba="0.85 0.2 0.15 1"/>
    <material name="heading_mat" rgba="1 1 1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="1 1 1"/>

    <!-- 8x8 board, centered at the origin, one unit per square -->
    <geom name="board" type="plane" size="4 4 0.1" material="chess_mat"/>

    <!-- Thin frame around the board for visual reference -->
    <geom type="box" pos="0 4.05 0.05" size="4.1 0.05 0.05" rgba="0.25 0.15 0.08 1"/>
    <geom type="box" pos="0 -4.05 0.05" size="4.1 0.05 0.05" rgba="0.25 0.15 0.08 1"/>
    <geom type="box" pos="4.05 0 0.05" size="0.05 4.1 0.05" rgba="0.25 0.15 0.08 1"/>
    <geom type="box" pos="-4.05 0 0.05" size="0.05 4.1 0.05" rgba="0.25 0.15 0.08 1"/>

    <!-- Circular robot, starting centered on square a1 (bottom-left) -->
    <body name="robot1" pos="3 3 0.06">
      <joint name="robot1_x" type="slide" axis="1 0 0" damping="8"/>
      <joint name="robot1_y" type="slide" axis="0 1 0" damping="8"/>
      <joint name="robot1_yaw" type="hinge" axis="0 0 1" damping="2"/>

      <geom name="robot1_body" type="cylinder" size="0.5 0.05" material="robot_mat" mass="1.0"/>
      <!-- Heading marker so you can see which way the robot is facing -->
      <geom name="robot1_heading_marker" type="box" pos="0.15 0 0.03" size="0.1 0.05 0.02" material="heading_mat"/>
    </body>
     <body name="robot2" pos="1 1 0.06">
      <joint name="robot2_x" type="slide" axis="1 0 0" damping="8"/>
      <joint name="robot2_y" type="slide" axis="0 1 0" damping="8"/>
      <joint name="robot2_yaw" type="hinge" axis="0 0 1" damping="2"/>

      <geom name="robot2_body" type="cylinder" size="0.5 0.05" material="robot_mat" mass="1.0"/>
      <!-- Heading marker so you can see which way the robot is facing -->
      <geom name="robot2_heading_marker" type="box" pos="0.15 0 0.03" size="0.1 0.05 0.02" material="heading_mat"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="robot1_motor_x" joint="robot1_x" gear="1" ctrlrange="-15 15"/>
    <motor name="robot1_motor_y" joint="robot1_y" gear="1" ctrlrange="-15 15"/>
    <motor name="robot1_motor_yaw" joint="robot1_yaw" gear="1" ctrlrange="-5 5"/>
  </actuator>
  <actuator>
    <motor name="robot2_motor_x" joint="robot2_x" gear="1" ctrlrange="-15 15"/>
    <motor name="robot2_motor_y" joint="robot2_y" gear="1" ctrlrange="-15 15"/>
    <motor name="robot2_motor_yaw" joint="robot2_yaw" gear="1" ctrlrange="-5 5"/>
  </actuator>
</mujoco>
